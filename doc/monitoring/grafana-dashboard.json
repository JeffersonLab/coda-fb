{
  "title": "coda-fb pipeline",
  "uid": "coda-fb-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "description": "coda-fb receive -> build -> forward pipeline (coda-fb --metrics-port). Metric names per doc/monitoring.md.",
  "tags": [
    "coda-fb",
    "ejfat"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(coda_fb_ready, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Instance"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Readiness",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "red"
                },
                "1": {
                  "text": "READY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "coda_fb_ready{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Seconds since last activity",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "timestamp(coda_fb_last_activity_timestamp_seconds{instance=~\"$instance\"}) - coda_fb_last_activity_timestamp_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{stage}}"
        }
      ],
      "description": "How long before the latest scrape each stage last did something. Small while data flows; grows while a stage is stalled."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - coda_fb_start_time_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Receive and send throughput",
      "description": "Sent = frame bytes released by E2SAR; excludes LB/RE/UDP/IP headers. Not downstream delivery.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "rate(coda_fb_recv_udp_bytes_total{instance=~\"$instance\"}[1m]) * 8",
          "legendFormat": "{{instance}} received (UDP)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "rate(coda_fb_send_bytes_total{instance=~\"$instance\",stage=\"released\"}[1m]) * 8",
          "legendFormat": "{{instance}} sent (frame payload)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Frame and submission rates",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (instance, outcome) (rate(coda_fb_build_frames_total{instance=~\"$instance\",outcome=~\"complete|partial\"}[1m]))",
          "legendFormat": "{{instance}} built {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "rate(coda_fb_send_frames_total{instance=~\"$instance\",outcome=\"submitted\"}[1m])",
          "legendFormat": "{{instance}} submitted"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "rate(coda_fb_send_frames_released_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} released by E2SAR"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Losses, errors and drops",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Receive losses and errors (per 5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (instance, reason) (increase(coda_fb_recv_events_lost_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} lost: {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (instance, reason) (increase(coda_fb_recv_errors_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} error: {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (instance, reason) (increase(coda_fb_recv_events_rejected_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} rejected: {{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Frames not built or dropped (per 5m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (instance, outcome) (increase(coda_fb_build_frames_total{instance=~\"$instance\",outcome=~\"build_failed|discarded_shutdown\"}[5m]))",
          "legendFormat": "{{instance}} {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (instance, outcome) (increase(coda_fb_send_frames_total{instance=~\"$instance\",outcome=~\"dropped_.*|rejected\"}[5m]))",
          "legendFormat": "{{instance}} send {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (instance, output) (increase(coda_fb_build_output_errors_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} {{output}} output errors"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "E2SAR send packet errors",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "rate(coda_fb_send_packet_errors_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} packet errors/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "rate(coda_fb_send_sync_errors_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} sync errors/s"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Queue and backpressure",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Send queue utilization",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "coda_fb_send_inflight_frames{instance=~\"$instance\"} / coda_fb_send_capacity_frames{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} frames"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "coda_fb_send_inflight_bytes{instance=~\"$instance\"} / coda_fb_send_capacity_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} bytes"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Time builders spent blocked",
      "description": "Blocked seconds per second, summed over builder threads (can exceed 100% with several threads).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "rate(coda_fb_send_blocked_seconds_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Builder backlog",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "coda_fb_build_pending_slices{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} pending slices"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "coda_fb_build_frames_in_progress{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} frames in progress"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Frame assembly latency (first slice to built)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(coda_fb_build_assembly_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(coda_fb_build_assembly_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} p99"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Send queue wait and E2SAR release latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(coda_fb_send_queue_wait_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} queue wait p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(coda_fb_send_release_latency_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} release p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(coda_fb_send_release_latency_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} release p99"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Frame size",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(coda_fb_build_frame_size_bytes_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(coda_fb_build_frame_size_bytes_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} p99"
        }
      ]
    }
  ]
}