# CODA Frame Builder container configuration.
#
#   cp docker/coda-fb.env.example coda-fb.env
#   $EDITOR coda-fb.env
#   docker run --env-file coda-fb.env ...
#
# Only RECV_EJFAT_URI and RECEIVER_IP are required. Everything else falls back to
# the coda-fb defaults documented in ../README.md. Leave a variable commented
# out to accept that default; an empty value is meaningful only where noted.

# --- Required -------------------------------------------------------------

# Instance URI of the load balancer to receive from (LB #1).
# EJFAT_URI is the deprecated name for the same setting; set one, not both.
RECV_EJFAT_URI=ejfats://token@cp-host.example.org:18347/lb/1?data=10.0.0.1&sync=10.0.0.1:19010

# Local address the load balancer sends UDP to. Must be an address of the host
# as the load balancer sees it, which is why the container needs host networking.
# Set AUTO_IP=1 instead to let coda-fb detect it.
RECEIVER_IP=10.0.0.5
#AUTO_IP=0

# --- Receiver -------------------------------------------------------------

# Starting UDP port. Receiver thread i listens on RECEIVER_PORT+i, so with
# THREADS=4 the host must allow 10000-10003.
RECEIVER_PORT=10000
THREADS=4

# Pin receiver threads to specific cores. If set, this OVERRIDES THREADS and
# the thread count becomes the number of cores listed.
#CORES=4 5 6 7
#NUMA_NODE=0

#BUFSIZE=3145728
#RECV_TIMEOUT=500
#REPORT_INTERVAL=5000
#PREFER_IPV6=0

# Skip TLS certificate validation on the control-plane connection.
#TLS_NOVALIDATE=0

# --- Mode -----------------------------------------------------------------

# 1 = aggregate streams into EVIO-6 frames, 0 = reassembly-only raw output.
ENABLE_FRAMEBUILD=1

# --- Aggregation (ENABLE_FRAMEBUILD=1) ------------------------------------

# Number of data streams (ROCs) expected per frame.
EXPECTED_STREAMS=3
FB_THREADS=1

# Milliseconds to wait for missing streams before emitting a partial frame.
#FRAME_TIMEOUT=1000
#FRAMENUMBER_SLOP=0

# --- File output ----------------------------------------------------------

# Where .evio files are written inside the container; mount a volume here.
# Set to empty (FB_OUTPUT_DIR=) to disable file output entirely, e.g. ET-only.
FB_OUTPUT_DIR=/data
#FB_OUTPUT_PREFIX=frames

# --- ET output ------------------------------------------------------------

# ET memory-mapped file. Leave unset to disable ET output.
#ET_FILE=/tmp/et_sys_pagg

# Set ET_HOST for a direct network connection to a remote ET system.
# Leave it unset for broadcast discovery on the local network.
#ET_HOST=etnode.example.org
#ET_PORT=11111
#ET_EVENT_SIZE=2097152

# Run the ET system inside this container instead of connecting to an external
# one. Requires --ipc=host and a writable, shared location for ET_FILE.
#RUN_ET_START=0
#ET_START_NEVENTS=1000
#ET_START_EVENT_SIZE=2097152
#ET_START_WAIT=30
#ET_START_ARGS=

# --- Forwarding to a second load balancer (ENABLE_FRAMEBUILD=1) ------------

# Instance URI of a SECOND, separately reserved load balancer. Each built frame
# is sent there as one E2SAR event as soon as it is built. Unset = disabled.
#SEND_EJFAT_URI=ejfats://token2@cp2.example.org:18347/lb/7?data=10.0.1.1&sync=10.0.1.1:19010

# E2SAR data id of the forwarded frames, and outbound event number offset
# (event number = frame number + offset, offset >= 1).
#SEND_DATA_ID=1
#SEND_EVENT_OFFSET=1
# Sync source id (unique per sender on the LB); unset = derived from host name.
#SEND_SRC_ID=
# Address(es) registered as sender; unset = auto-detected route to the LB.
#SEND_SENDER_IP=
#SEND_PARTIAL_FRAMES=1
#SEND_MTU=1500
#SEND_SOCKETS=4
#SEND_BUFSIZE=3145728
#SEND_RATE=-1
#SEND_IPV6=0

# Bound on frames/bytes handed to E2SAR but not yet sent, and what to do when
# it is reached: block the builders (default) or drop after SEND_BLOCK_TIMEOUT ms.
#SEND_QUEUE_FRAMES=256
#SEND_QUEUE_BYTES=536870912
#SEND_OVERFLOW=block
#SEND_BLOCK_TIMEOUT=1000
# Milliseconds allowed at shutdown to send completed frames.
#SEND_DRAIN_TIMEOUT=10000

# --- Reassembly-only output (ENABLE_FRAMEBUILD=0) -------------------------

#OUTPUT_DIR=/data
#FILE_PREFIX=events
#FILE_EXTENSION=.bin

# --- Diagnostics and shutdown ---------------------------------------------

# Prometheus endpoint at http://<METRICS_BIND>:<METRICS_PORT>/metrics.
# With host networking the port is on the host: one port per instance.
#METRICS_PORT=9465
#METRICS_BIND=0.0.0.0

#VERBOSE_FRAMES=0
#VERBOSE_REASSEMBLE=0

# Seconds to let coda-fb deregister from the load balancer and drain builders
# after SIGINT before it is SIGKILLed. Keep docker stop -t above this.
#SHUTDOWN_GRACE=60

# Raw flags appended to the coda-fb command line.
#EXTRA_ARGS=
